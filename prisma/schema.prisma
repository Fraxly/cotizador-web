generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String
  llmApiKey  String?
  llmModel   String?
  llmBaseUrl String?
  createdAt  DateTime @default(now())
  quotes     Quote[]
  qualificationsDocs QualificationsDoc[]
  conversations Conversation[]
}

model Conversation {
  id        String   @id @default(cuid())
  tipo      String
  messages  String
  state     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, tipo])
}

model PriceReference {
  id               Int      @id @default(autoincrement())
  numeroPropuesta  String
  fecha            String
  cliente          String
  categoria        String
  concepto         String
  und              Float
  valorUnitario    Float
  moneda           String
  tiempoProduccion String?
  condicionesPago  String?
  descripcion      String?

  @@index([categoria])
}

model CaseStudy {
  id               String   @id @default(cuid())
  cliente          String
  servicioTitulo   String
  descripcion      String
  porQueComparable String?
  url              String?
  contactoNombre   String?
  contactoEmail    String?
  contactoTelefono String?
  categoria        String?
  createdAt        DateTime @default(now())
}

model CompanyProfile {
  id        String   @id @default("default")
  aboutText String
  updatedAt DateTime @updatedAt
}

model QualificationsDoc {
  id           String   @id @default(cuid())
  numero       String   @unique
  cliente      String
  subtitulo    String
  idioma       String   @default("es")
  aboutText    String
  casos        String
  terminos     String
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
}

model Quote {
  id             String   @id @default(cuid())
  numero         String   @unique
  cliente        String
  atencion       String
  emitido        String
  fechaCorta     String
  anio           String
  moneda         String   @default("PEN")
  intro          String
  items          String
  detalle        String
  tiempoProd     String?
  condiciones    String
  contactoDinamita String?
   transferencia  String?
   aplicaIgv     Boolean  @default(true)
   userId         String
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
